# Rename this file to .env and fill in your API keys

# Data directory for database and other persistent data
DATA_DIR=./data

# OpenRouter API Key (used for all models including Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=https://your-arena.example
OPENROUTER_APP_TITLE="Dhivehi Translation Arena"
# Set true to route only through Zero Data Retention endpoints.
OPENROUTER_ENFORCE_ZDR=false

# Flask secret key (used for session management)
SECRET_KEY=your_secret_key_here

# Initial admin password for Docker init (optional, defaults to 'changeme')
INIT_ADMIN_PASSWORD=your_secure_password_here

# Comma-separated list of usernames exempt from monthly budget limits (optional)
UNLIMITED_USERS=admin
